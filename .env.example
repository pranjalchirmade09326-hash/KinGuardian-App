# KinGuardian AI - Client & Production Server Environment Variables

# Mobile & Web Client Settings
EXPO_PUBLIC_API_URL=https://api.kinguardian.local
EXPO_PUBLIC_GEMINI_API_KEY=your_mock_gemini_api_key_here
EXPO_PUBLIC_ENVIRONMENT=development

# -------------------------------------------------------------
# Meta WhatsApp Business Cloud API (Production Settings)
# Get these from Meta for Developers (https://developers.facebook.com)
# -------------------------------------------------------------
PORT=4000
META_API_VERSION=v21.0

# 1. Meta App & Webhook Verification
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret_here
WHATSAPP_WEBHOOK_VERIFY_TOKEN=kinguardian_verify_secret_2026

# 2. WhatsApp Business Account (WABA) & Phone
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_account_id_here

# 3. Permanent System User Access Token (whatsapp_business_messaging, whatsapp_business_management)
WHATSAPP_ACCESS_TOKEN=EAAG...your_permanent_system_user_token_here
